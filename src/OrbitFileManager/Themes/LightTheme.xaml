<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Orbit Daylight & Signal Orange (light). Neutral zinc greys; a deeper orange keeps icons and links
         legible on white, and accent buttons keep the same dark ink as the dark theme. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="BrowserBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InspectorBackgroundBrush" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFAFAFA" />

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#FFE4E4E7" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#FFD4D4D8" />

    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="ActiveTabBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="InactiveTabBackgroundBrush" Color="#FFEFEFF1" />

    <SolidColorBrush x:Key="SelectedRowBackgroundBrush" Color="#FFFFEDD5" />
    <SolidColorBrush x:Key="SelectedRowBorderBrush" Color="#FFEA580C" />

    <SolidColorBrush x:Key="AccentBrush" Color="#FFEA580C" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFF97316" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FF1A1108" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1FEA580C" />

    <SolidColorBrush x:Key="DangerBrush" Color="#FFE11D48" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FFBE123C" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1FE11D48" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF18181B" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF52525B" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#FFA1A1AA" />

    <!-- Folder glyphs drawn as vector paths (e.g. Folder Size Analyzer rows) -->
    <SolidColorBrush x:Key="FolderAccentBrush" Color="#FFF59E0B" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#FFD4D4D8" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#FFA1A1AA" />

    <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#FFFAFAFA">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#FFE4E4E7">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
