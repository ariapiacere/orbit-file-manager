<Window x:Class="OrbitFileManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:OrbitFileManager.Models"
        xmlns:converters="clr-namespace:OrbitFileManager.Converters"
        xmlns:controls="clr-namespace:OrbitFileManager.Controls"
        Title="Orbit File Manager"
        Icon="pack://application:,,,/OrbitFileManager;component/Resources/OrbitFileManager.ico"
        Width="1420"
        Height="880"
        MinWidth="960"
        MinHeight="580"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:BooleanToVisibilityExConverter x:Key="BoolToVis" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
        <converters:EnumEqualsToVisibilityConverter x:Key="EnumToVis" />
        <converters:EnumEqualsToBooleanConverter x:Key="EnumToBool" />
        <converters:RatioToWidthConverter x:Key="RatioToWidth" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Top Action Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Main Workspace (Sidebar | Single or Dual Browser Panes | Preview) -->
            <RowDefinition Height="*" />
            <!-- Row 2: Expandable Operations Queue Panel (populated in Phase 3) -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Bottom Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 0: TOP TOOLBAR                                                  -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,5">
            <DockPanel x:Name="ToolbarDock" LastChildFill="False" MinHeight="30">

                <!-- Right Side View & Workspace Controls (declared first so it always keeps its space; the left groups clip instead) -->
                <StackPanel x:Name="ToolbarRightGroup" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 5 Display Modes -->
                    <Border Style="{StaticResource ToolbarSegmentStyle}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Details, Mode=OneWay}"
                                          Command="{Binding SetViewModeCommand}"
                                          CommandParameter="{x:Static models:BrowserViewMode.Details}"
                                          ToolTip="Details View">
                                <Path Data="{StaticResource IconViewDetails}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=List, Mode=OneWay}"
                                          Command="{Binding SetViewModeCommand}"
                                          CommandParameter="{x:Static models:BrowserViewMode.List}"
                                          ToolTip="Compact List View">
                                <Path Data="{StaticResource IconViewList}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="13" Height="13" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=SmallIcons, Mode=OneWay}"
                                          Command="{Binding SetViewModeCommand}"
                                          CommandParameter="{x:Static models:BrowserViewMode.SmallIcons}"
                                          ToolTip="Small Icons View">
                                <Path Data="{StaticResource IconViewSmall}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" Width="13" Height="13" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=LargeIcons, Mode=OneWay}"
                                          Command="{Binding SetViewModeCommand}"
                                          CommandParameter="{x:Static models:BrowserViewMode.LargeIcons}"
                                          ToolTip="Large Icons View">
                                <Path Data="{StaticResource IconViewTiles}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" />
                            </ToggleButton>
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Thumbnails, Mode=OneWay}"
                                          Command="{Binding SetViewModeCommand}"
                                          CommandParameter="{x:Static models:BrowserViewMode.Thumbnails}"
                                          ToolTip="Thumbnails View">
                                <Path Data="{StaticResource IconViewThumbnails}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- Panel toggles -->
                    <Border Style="{StaticResource ToolbarSegmentStyle}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowHiddenFiles, Mode=OneWay}"
                                          Command="{Binding ToggleHiddenFilesCommand}"
                                          ToolTip="Toggle Hidden Files (Ctrl+H)">
                                <Path Data="{StaticResource IconEye}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowSidebar, Mode=OneWay}"
                                          Command="{Binding ToggleSidebarCommand}"
                                          ToolTip="Toggle Navigation Sidebar (Ctrl+B)">
                                <Path Data="{StaticResource IconSidebar}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowOperationQueuePanel, Mode=OneWay}"
                                          Command="{Binding ToggleOperationQueuePanelCommand}"
                                          ToolTip="Toggle File Operation Queue Panel">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconQueue}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                                    <TextBlock Text="{Binding OperationQueue.ActiveJobCount, StringFormat=' ({0})'}"
                                               FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Visibility="{Binding OperationQueue.ActiveJobCount, Converter={StaticResource NullToVis}}" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                          IsChecked="{Binding ShowPreviewPanel, Mode=OneWay}"
                                          Command="{Binding TogglePreviewPanelCommand}"
                                          ToolTip="Toggle Preview &amp; Inspector Panel (Ctrl+P)">
                                <Path Data="{StaticResource IconPreview}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="Switch Dark / Light Theme">
                        <Path Data="{StaticResource IconSun}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <Button Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="Settings">
                        <Path Data="{StaticResource IconSettings}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <!-- Brand: logo mark (shapes in Resources/Icons.xaml) + wordmark -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                        <Canvas Width="64" Height="64">
                            <Path Data="{StaticResource LogoRingFull}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="3.6" />
                            <Path Data="{StaticResource LogoFolderBack}" Fill="{DynamicResource AccentBrush}" />
                            <Path Data="{StaticResource LogoFolderFront}" Fill="{DynamicResource AccentHoverBrush}" />
                            <Path Data="{StaticResource LogoRingFront}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="3.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{StaticResource LogoSatellite}" Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource ToolbarBackgroundBrush}" StrokeThickness="2.4" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Orbit"
                               FontWeight="SemiBold"
                               FontSize="14.5"
                               Margin="6,0,0,1"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Buttons -->
                <Border DockPanel.Dock="Left" Style="{StaticResource ToolbarSegmentStyle}" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateBackCommand}" ToolTip="Back (Alt+Left)">
                            <Path Data="{StaticResource IconBack}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateForwardCommand}" ToolTip="Forward (Alt+Right)">
                            <Path Data="{StaticResource IconForward}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding NavigateUpCommand}" ToolTip="Up One Level (Alt+Up)">
                            <Path Data="{StaticResource IconUp}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RefreshCommand}" ToolTip="Refresh Workspace (F5)">
                            <Path Data="{StaticResource IconRefresh}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                </Border>

                <!-- File Operations -->
                <StackPanel x:Name="ToolbarActionsPanel" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CreateNewFolderCommand}" ToolTip="New Folder (Ctrl+Shift+N)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconNewFolder}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="ToolbarLabelNewFolder" Text="New Folder" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CreateNewFileCommand}" ToolTip="New Text File (Ctrl+N)">
                        <Path Data="{StaticResource IconNewFile}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" Margin="5,0" />

                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CutSelectedCommand}" ToolTip="Cut (Ctrl+X)">
                        <Path Data="{StaticResource IconCut}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding CopySelectedCommand}" ToolTip="Copy (Ctrl+C)">
                        <Path Data="{StaticResource IconCopy}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding PasteCommand}" ToolTip="Paste (Ctrl+V)">
                        <Path Data="{StaticResource IconPaste}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RenameSelectedCommand}" ToolTip="Rename Selected (F2)">
                        <Path Data="{StaticResource IconRename}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenBatchRenameCommand}" ToolTip="Batch Rename Tool (Ctrl+M)" Visibility="{Binding ShowToolbarBatchRename, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconBatchRename}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="ToolbarLabelBatchRename" Text="Batch Rename" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoLastBatchRenameCommand}" ToolTip="Undo Last Batch Rename (Ctrl+Z)" Visibility="{Binding CanUndoBatchRename, Converter={StaticResource BoolToVis}}">
                        <Path Data="{StaticResource IconUndo}" Stroke="#FFF59E0B" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding DeleteToRecycleBinCommand}" ToolTip="Move to Recycle Bin (Delete) • Shift+Delete for Permanent">
                        <Path Data="{StaticResource IconTrash}" Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" Margin="5,0" Visibility="{Binding ShowToolbarSearch, Converter={StaticResource BoolToVis}}" />

                    <!-- Advanced Search -->
                    <Button Style="{StaticResource ToolbarButtonStyle}" Command="{Binding OpenAdvancedSearchCommand}" ToolTip="Advanced Search in New Tab (Ctrl+Shift+F)" Visibility="{Binding ShowToolbarSearch, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconSearch}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="ToolbarLabelSearch" Text="Search" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" Margin="5,0" Visibility="{Binding ShowToolbarDualPane, Converter={StaticResource BoolToVis}}" />

                    <!-- Dual-Pane Controls -->
                    <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                  IsChecked="{Binding IsDualPane, Mode=OneWay}"
                                  Command="{Binding ToggleDualPaneCommand}"
                                  Visibility="{Binding ShowToolbarDualPane, Converter={StaticResource BoolToVis}}"
                                  ToolTip="Toggle Dual-Pane Mode (Ctrl+Shift+D) • F6 Switches Active Pane">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconDualPane}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="ToolbarLabelDualPane" Text="Dual Pane" FontSize="12" Margin="5,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </ToggleButton>

                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding ToggleSplitOrientationCommand}"
                                ToolTip="Switch Vertical / Horizontal Split Layout">
                            <Path Data="{StaticResource IconSplitHorizontal}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                Command="{Binding SwapPanesCommand}"
                                ToolTip="Swap Left and Right Panes">
                            <Path Data="{StaticResource IconSwap}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                        </Button>
                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding IsSyncNavigationEnabled, Mode=OneWay}"
                                      Command="{Binding ToggleSyncNavigationCommand}"
                                      ToolTip="Synchronize Folder Navigation Between Panes">
                            <Path Data="{StaticResource IconSync}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7" StrokeStartLineCap="Round" Width="14" Height="14" Stretch="Uniform" />
                        </ToggleButton>
                        <ToggleButton Style="{StaticResource ToolbarToggleButtonStyle}"
                                      IsChecked="{Binding IsComparingPanes, Mode=OneWay}"
                                      Command="{Binding ComparePanesCommand}"
                                      ToolTip="Compare Folder Contents Between Panes (click again to turn off)">
                            <Path Data="{StaticResource IconCompare}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" />
                        </ToggleButton>
                    </StackPanel>

                    <Border Width="1" Height="18" Background="{DynamicResource BorderSubtleBrush}" Margin="5,0" Visibility="{Binding ShowToolbarToolsMenu, Converter={StaticResource BoolToVis}}" />

                    <!-- Productivity Tools Menu -->
                    <Button x:Name="ToolsMenuButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Tag="{Binding}"
                            Visibility="{Binding ShowToolbarToolsMenu, Converter={StaticResource BoolToVis}}"
                            Click="ToolsMenuButton_Click"
                            ToolTip="Productivity Tools (Duplicate Finder, Folder Size, Checksums)">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconTools}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="14" Height="14" Stretch="Uniform" />
                            <TextBlock x:Name="ToolbarLabelTools" Text="Tools" Margin="5,0,3,0" VerticalAlignment="Center" Visibility="{Binding ShowToolbarLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                            <Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Width="9" Height="9" Stretch="Uniform" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Duplicate File Finder..." InputGestureText="Ctrl+Shift+U" Command="{Binding OpenDuplicateFinderCommand}" />
                                <MenuItem Header="Folder Size Analyzer..." InputGestureText="Ctrl+Shift+Z" Command="{Binding OpenFolderSizeAnalyzerCommand}" />
                                <MenuItem Header="Calculate File Checksums..." InputGestureText="Ctrl+Shift+K" Command="{Binding OpenChecksumToolCommand}" />
                                <Separator />
                                <MenuItem Header="Batch Rename Selected..." InputGestureText="Ctrl+M" Command="{Binding OpenBatchRenameCommand}" />
                                <MenuItem Header="Advanced Search..." InputGestureText="Ctrl+Shift+F" Command="{Binding OpenAdvancedSearchCommand}" />
                                <Separator />
                                <MenuItem Header="Compare Dual Panes" Command="{Binding ComparePanesCommand}" IsChecked="{Binding IsComparingPanes, Mode=OneWay}" IsEnabled="{Binding IsDualPane}" />
                                <MenuItem Header="Save Current Workspace..." Command="{Binding SaveCurrentWorkspaceCommand}" />
                                <Separator />
                                <MenuItem Header="Check for Updates..." Command="{Binding CheckForUpdatesCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 1: MAIN WORKSPACE (SIDEBAR | BROWSER PANES | PREVIEW)           -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="260" MinWidth="170" MaxWidth="520" />
                <ColumnDefinition x:Name="SidebarSplitterColumn" Width="5" />
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="PreviewColumn" Width="310" MinWidth="220" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT SIDEBAR ────────────────────────────────────────────── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVis}}">
                <ScrollViewer x:Name="SidebarScrollViewer" VerticalScrollBarVisibility="Auto" Padding="8,8,6,12">
                    <StackPanel>

                        <!-- Quick Access -->
                        <DockPanel Margin="6,2,2,4">
                            <ToggleButton DockPanel.Dock="Right"
                                          Style="{StaticResource ToolbarToggleButtonStyle}"
                                          Padding="5,1"
                                          IsChecked="{Binding MiniTreeMode, Mode=OneWay}"
                                          Command="{Binding ToggleMiniTreeModeCommand}"
                                          ToolTip="Toggle Compact Mini-Tree Sidebar">
                                <TextBlock Text="Mini" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </ToggleButton>
                            <TextBlock Text="QUICK ACCESS"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding QuickAccessItems}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding DataContext.NavigateToPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Path}"
                                            ToolTip="{Binding Path}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconFolder}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Favorites (Supports Drag & Drop folders directly into Favorites!) -->
                        <Border AllowDrop="True"
                                Background="Transparent"
                                DragOver="FavoritesSection_DragOver"
                                Drop="FavoritesSection_Drop"
                                Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel Margin="6,2,2,4">
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource ToolbarButtonStyle}"
                                            Padding="4,2"
                                            ToolTip="Pin Current Folder to Favorites"
                                            Command="{Binding AddCurrentFolderToFavoritesCommand}">
                                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform" />
                                    </Button>
                                    <TextBlock Text="FAVORITES"
                                               FontSize="10.5"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                </DockPanel>

                                <TextBlock Text="Drag folders here or click + to pin"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="8,2,4,4"
                                           Visibility="{Binding FavoriteItems.Count, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                                <ItemsControl ItemsSource="{Binding FavoriteItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <Grid.ContextMenu>
                                                    <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="Rename Display Label..."
                                                                  Command="{Binding RenameFavoriteCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Remove from Favorites"
                                                                  Command="{Binding RemoveFavoriteCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Style="{StaticResource SidebarNavButtonStyle}"
                                                        Command="{Binding DataContext.NavigateToPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Path}"
                                                        ToolTip="{Binding Path}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Path Data="{StaticResource IconStar}" Stroke="#FFF59E0B" StrokeThickness="1.7" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource ToolbarButtonStyle}"
                                                        Padding="4,3"
                                                        ToolTip="Remove Favorite"
                                                        Command="{Binding DataContext.RemoveFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}">
                                                    <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" Width="8" Height="8" Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Saved Workspaces -->
                        <DockPanel Margin="6,2,2,4">
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource ToolbarButtonStyle}"
                                    Padding="4,2"
                                    ToolTip="Save Current Panes &amp; Tabs as Workspace"
                                    Command="{Binding SaveCurrentWorkspaceCommand}">
                                <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="WORKSPACES"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding SavedWorkspaces}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Style="{StaticResource SidebarNavButtonStyle}"
                                                Command="{Binding DataContext.LoadWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource IconDualPane}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource ToolbarButtonStyle}"
                                                Padding="4,3"
                                                ToolTip="Delete Workspace"
                                                Command="{Binding DataContext.DeleteWorkspaceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.7" Width="8" Height="8" Stretch="Uniform" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Connected Drives -->
                        <TextBlock Text="DRIVES (THIS PC)"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="6,2,0,4" />
                        <ItemsControl ItemsSource="{Binding Drives}" Margin="0,0,0,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding DataContext.NavigateToPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding RootPath}"
                                            ToolTip="{Binding CapacitySummary}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DisplayLabel}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <Border x:Name="CapacityTrack"
                                                    Height="4"
                                                    CornerRadius="2"
                                                    Background="{DynamicResource BorderSubtleBrush}"
                                                    Margin="24,4,2,2"
                                                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                                                <Border HorizontalAlignment="Left"
                                                        CornerRadius="2">
                                                    <Border.Style>
                                                        <!-- Drives at 90%+ usage switch to the danger color -->
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNearlyFull}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource RatioToWidth}">
                                                            <Binding Path="UsageRatio" />
                                                            <Binding ElementName="CapacityTrack" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Border>
                                            <TextBlock Text="{Binding CapacitySummary}"
                                                       FontSize="10.5"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="24,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Full Folder Tree (Hidden when MiniTreeMode is enabled) -->
                        <StackPanel Visibility="{Binding MiniTreeMode, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                            <TextBlock Text="FOLDER TREE"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="6,2,0,4" />
                            <TreeView ItemsSource="{Binding FolderTreeRoots}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Margin="0,0,0,10"
                                      PreviewMouseWheel="SidebarTreeView_PreviewMouseWheel"
                                      SelectedItemChanged="FolderTree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Margin="2,1">
                                            <Image Source="{Binding Icon}" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </StackPanel>

                        <!-- Recent Locations (Also acts as compact path hierarchy in MiniTreeMode) -->
                        <TextBlock Text="RECENT LOCATIONS"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="6,2,0,4" />
                        <ItemsControl ItemsSource="{Binding RecentFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource SidebarNavButtonStyle}"
                                            Command="{Binding DataContext.NavigateToPathCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="{StaticResource IconClock}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Left Splitter -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtleBrush}"
                          ShowsPreview="False"
                          Visibility="{Binding ShowSidebar, Converter={StaticResource BoolToVis}}" />

            <!-- ─── CENTER SINGLE / DUAL-PANE BROWSER CONTAINER ────────────── -->
            <Grid x:Name="PanesHostGrid" Grid.Column="2" Background="{DynamicResource BrowserBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaneCol" Width="*" MinWidth="220" />
                    <ColumnDefinition x:Name="VerticalPaneSplitterCol" Width="0" />
                    <ColumnDefinition x:Name="RightPaneCol" Width="0" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopPaneRow" Height="*" MinHeight="160" />
                    <RowDefinition x:Name="HorizontalPaneSplitterRow" Height="0" />
                    <RowDefinition x:Name="BottomPaneRow" Height="0" />
                </Grid.RowDefinitions>

                <controls:BrowserPaneControl x:Name="LeftPaneControl"
                                             Grid.Row="0"
                                             Grid.Column="0"
                                             DataContext="{Binding LeftPane}"
                                             MainVm="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />

                <GridSplitter x:Name="VerticalPaneSplitter"
                              Grid.Row="0"
                              Grid.Column="1"
                              Style="{StaticResource VerticalPaneSplitterStyle}"
                              DragCompleted="PaneSplitter_DragCompleted"
                              MouseDoubleClick="PaneSplitter_MouseDoubleClick"
                              Visibility="Collapsed" />

                <GridSplitter x:Name="HorizontalPaneSplitter"
                              Grid.Row="1"
                              Grid.Column="0"
                              Style="{StaticResource HorizontalPaneSplitterStyle}"
                              DragCompleted="PaneSplitter_DragCompleted"
                              MouseDoubleClick="PaneSplitter_MouseDoubleClick"
                              Visibility="Collapsed" />

                <controls:BrowserPaneControl x:Name="RightPaneControl"
                                             Grid.Row="0"
                                             Grid.Column="2"
                                             DataContext="{Binding RightPane}"
                                             MainVm="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                             Visibility="Collapsed" />
            </Grid>

            <!-- Right Splitter -->
            <GridSplitter Grid.Column="3"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderSubtleBrush}"
                          ShowsPreview="False"
                          Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BoolToVis}}" />

            <!-- ─── RIGHT PREVIEW & INSPECTOR PANEL ─────────────────────────── -->
            <Border Grid.Column="4"
                    Background="{DynamicResource InspectorBackgroundBrush}"
                    Visibility="{Binding ShowPreviewPanel, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <!-- Empty Selection State -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="24"
                                Visibility="{Binding CurrentPreview.Kind, Converter={StaticResource EnumToVis}, ConverterParameter=None}">
                        <Path Data="{StaticResource IconInfo}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.6"
                              Width="32" Height="32"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              Margin="0,0,0,10" />
                        <TextBlock Text="Select a file or folder to inspect"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextAlignment="Center" />
                        <TextBlock Text="Preview images, code, metadata, and attach item notes."
                                   FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <!-- Populated Preview & Metadata -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Padding="14"
                                  Visibility="{Binding CurrentPreview.Name, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Image Source="{Binding CurrentPreview.Icon}" Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentPreview.Name}"
                                               FontSize="13.5"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CurrentPreview.TypeDescription}"
                                               FontSize="11.5"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Live Image Preview Surface -->
                            <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,12"
                                    ClipToBounds="True"
                                    Visibility="{Binding CurrentPreview.Kind, Converter={StaticResource EnumToVis}, ConverterParameter=Image}">
                                <StackPanel>
                                    <Border Background="{DynamicResource ToolbarBackgroundBrush}" Padding="6,4" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <TextBlock Text="{Binding CurrentPreview.DimensionsText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Fit" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" FontSize="11" Command="{Binding FitPreviewToPanelCommand}" />
                                                <Button Content="1:1" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" FontSize="11" Command="{Binding ActualSizePreviewCommand}" />
                                                <Button Content="−" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" FontSize="11" Command="{Binding ZoomOutPreviewCommand}" />
                                                <Button Content="+" Style="{StaticResource ToolbarButtonStyle}" Padding="6,2" FontSize="11" Command="{Binding ZoomInPreviewCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>

                                    <Border Background="{DynamicResource CheckerboardBrush}" MinHeight="180" MaxHeight="290">
                                        <Grid>
                                            <Image Source="{Binding CurrentPreview.ImagePreview}"
                                                   Stretch="Uniform"
                                                   MaxHeight="278"
                                                   Margin="6"
                                                   Visibility="{Binding IsFitToPanel, Converter={StaticResource BoolToVis}}" />

                                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                          VerticalScrollBarVisibility="Auto"
                                                          MaxHeight="278"
                                                          Visibility="{Binding IsFitToPanel, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}">
                                                <Image Source="{Binding CurrentPreview.ImagePreview}"
                                                       Stretch="None"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <Image.LayoutTransform>
                                                        <ScaleTransform ScaleX="{Binding ImageZoom}" ScaleY="{Binding ImageZoom}" />
                                                    </Image.LayoutTransform>
                                                </Image>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Live Text / Code Preview Surface -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding CurrentPreview.Kind, Converter={StaticResource EnumToVis}, ConverterParameter=Text}">
                                <StackPanel>
                                    <TextBox Text="{Binding CurrentPreview.TextPreview, Mode=OneWay}"
                                             IsReadOnly="True"
                                             Background="Transparent"
                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                             BorderThickness="0"
                                             FontFamily="Cascadia Mono, Consolas"
                                             FontSize="11.5"
                                             Padding="10"
                                             MaxHeight="270"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto" />
                                    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                                            Padding="8,4"
                                            Visibility="{Binding CurrentPreview.IsTextTruncated, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Showing first 64 KB of file"
                                                   FontSize="10.5"
                                                   Foreground="{DynamicResource TextMutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Status / Media / Binary Note -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0,0,0,12"
                                    Visibility="{Binding CurrentPreview.StatusMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding CurrentPreview.StatusMessage}"
                                           FontSize="11.5"
                                           FontFamily="Cascadia Mono, Segoe UI"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Metadata Card -->
                            <TextBlock Text="DETAILS &amp; METADATA"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,8" />

                            <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    Padding="10"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Size" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentPreview.SizeSummary}" FontSize="12.5" FontWeight="Medium" Margin="0,1,0,2" />
                                    <TextBlock Text="{Binding CurrentPreview.ExactBytesSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                                    <TextBlock Text="Modified" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentPreview.ModifiedText}" FontSize="12" Margin="0,1,0,8" />

                                    <TextBlock Text="Created" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentPreview.CreatedText}" FontSize="12" Margin="0,1,0,8" />

                                    <TextBlock Text="Attributes" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentPreview.AttributesText}" FontSize="12" TextWrapping="Wrap" Margin="0,1,0,8" />

                                    <StackPanel Visibility="{Binding CurrentPreview.LinkTarget, Converter={StaticResource NullToVis}}" Margin="0,0,0,8">
                                        <TextBlock Text="Link Target" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding CurrentPreview.LinkTarget}" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                    </StackPanel>

                                    <TextBlock Text="Location" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding CurrentPreview.FullPath}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Item Notes (Persisted in item_metadata.json) -->
                            <TextBlock Text="NOTES &amp; COMMENTS"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,0,0,6" />
                            <TextBox Style="{StaticResource ModernTextBoxStyle}"
                                     Text="{Binding SelectedItemNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="56"
                                     MaxHeight="110"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto" />
                            <Button Content="Save Note"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Right"
                                    Padding="10,4"
                                    Margin="0,6,0,8"
                                    Command="{Binding SaveSelectedItemNoteCommand}" />

                            <Button Content="Windows Properties..."
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,2,0,0"
                                    Command="{Binding ShowPropertiesCommand}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 2: EXPANDABLE FILE OPERATION QUEUE PANEL                        -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource ToolbarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                MaxHeight="195"
                Padding="12,8"
                Visibility="{Binding ShowOperationQueuePanel, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="FILE OPERATION QUEUE"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Clear Finished"
                                Style="{StaticResource ToolbarButtonStyle}"
                                FontSize="11"
                                Padding="8,2"
                                Command="{Binding ClearCompletedQueueJobsCommand}" />
                        <Button Content="Hide"
                                Style="{StaticResource ToolbarButtonStyle}"
                                FontSize="11"
                                Padding="8,2"
                                Command="{Binding ToggleOperationQueuePanelCommand}" />
                    </StackPanel>
                </DockPanel>

                <TextBlock Grid.Row="1"
                           Text="No queued file operations."
                           FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Margin="2,6,0,6"
                           Visibility="{Binding OperationQueue.Jobs.Count, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding OperationQueue.Jobs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ElevatedSurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="0,0,0,5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding SpeedText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Right"
                                                           Margin="10,0,0,0" />
                                            </DockPanel>

                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Height="5"
                                                         Margin="0,5,0,4"
                                                         Foreground="{DynamicResource AccentBrush}"
                                                         Background="{DynamicResource InputBackgroundBrush}"
                                                         BorderThickness="0" />

                                            <DockPanel>
                                                <TextBlock Text="{Binding SummaryText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding EtaText}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding PauseResumeLabel}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Margin="0,0,6,0"
                                                    Command="{Binding TogglePauseCommand}"
                                                    Visibility="{Binding CanPauseResume, Converter={StaticResource BoolToVis}}" />
                                            <Button Content="Cancel"
                                                    Style="{StaticResource DangerButtonStyle}"
                                                    FontSize="11"
                                                    Padding="8,3"
                                                    Command="{Binding CancelCommand}"
                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- ROW 3: BOTTOM STATUS BAR                                            -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{DynamicResource StatusBarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ActivePane.PaneId, StringFormat='[{0}]  '}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ActiveTab.ItemCountSummary}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ActiveTab.SelectionSummary}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding UpdateBadgeText}"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="9,1"
                            FontSize="11"
                            Margin="0,0,12,0"
                            Command="{Binding InstallUpdateCommand}"
                            ToolTip="Download and install the new version"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding DriveSpaceSummary}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,12,0"
                               VerticalAlignment="Center" />
                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,1"
                            ToolTip="{Binding StorageRootPath}">
                        <TextBlock Text="{Binding StorageModeBadge}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                    <Button Content="Cancel"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Foreground="{DynamicResource DangerBrush}"
                            Padding="6,1"
                            Margin="8,0,0,0"
                            Command="{Binding CancelActiveOperationCommand}"
                            Visibility="{Binding IsOperationBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

    </Grid>
</Window>
