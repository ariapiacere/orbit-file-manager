<Window x:Class="OrbitFileManager.Views.Dialogs.ChecksumDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Checksum Calculator"
        Width="680"
        Height="600"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Border Padding="20" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right"
                           x:Name="StatusBadgeText"
                           FontSize="12"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Cryptographic File Checksums" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Single-pass streaming MD5, SHA-1, SHA-256, and SHA-512 calculation"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- File Selector + Progress Bar -->
            <StackPanel Grid.Row="1" Margin="0,0,0,12">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="FILE:" Width="56" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    <ComboBox x:Name="FileCombo"
                              SelectionChanged="FileCombo_SelectionChanged"
                              DisplayMemberPath="FileName"
                              Height="30"
                              VerticalContentAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="FileMetaText" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                <ProgressBar x:Name="HashProgressBar"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             Visibility="Collapsed" />
            </StackPanel>

            <!-- Computed Digest Rows -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrowserBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="MD5" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Tag="MD5" Click="CopyHash_Click" />
                            <TextBox x:Name="Md5Box" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        </DockPanel>

                        <TextBlock Text="SHA-1" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Tag="SHA1" Click="CopyHash_Click" />
                            <TextBox x:Name="Sha1Box" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        </DockPanel>

                        <TextBlock Text="SHA-256" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Tag="SHA256" Click="CopyHash_Click" />
                            <TextBox x:Name="Sha256Box" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" />
                        </DockPanel>

                        <TextBlock Text="SHA-512" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,3" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Tag="SHA512" Click="CopyHash_Click" />
                            <TextBox x:Name="Sha512Box" Style="{StaticResource ModernTextBoxStyle}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Expected Hash Verification -->
            <Border Grid.Row="3"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10"
                    Margin="0,12,0,0">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right"
                                   x:Name="VerifyResultText"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="VERIFY EXPECTED HASH (PASTE ANY MD5 / SHA-1 / SHA-256 / SHA-512)"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="ExpectedHashBox"
                             Style="{StaticResource ModernTextBoxStyle}"
                             FontFamily="Consolas"
                             FontSize="12"
                             TextChanged="ExpectedHashBox_TextChanged" />
                </StackPanel>
            </Border>

            <!-- Footer -->
            <DockPanel Grid.Row="4" Margin="0,14,0,0">
                <Button DockPanel.Dock="Left"
                        Content="Copy Full Report"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopyReport_Click" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelCalcButton"
                            Content="Cancel Calculation"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Visibility="Collapsed"
                            Margin="0,0,8,0"
                            Click="CancelCalc_Click" />
                    <Button Content="Close"
                            IsCancel="True"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="92" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
