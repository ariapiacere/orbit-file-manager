<Window x:Class="OrbitFileManager.Views.Dialogs.DuplicateFinderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Duplicate File Finder"
        Width="920"
        Height="640"
        MinWidth="740"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Border Padding="20" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <DockPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right"
                           x:Name="SummaryBadgeText"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="Duplicate File Finder" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="Exact 3-stage verification: Byte Size → 16 KB Edge Signature → Full Streaming SHA-256"
                               FontSize="11.5"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- Scan Controls -->
            <Border Grid.Row="1"
                    Background="{DynamicResource InputBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right"
                                x:Name="StopScanButton"
                                Content="Stop"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="Collapsed"
                                Margin="8,0,0,0"
                                Click="StopScan_Click" />
                        <Button DockPanel.Dock="Right"
                                x:Name="StartScanButton"
                                Content="Scan Folder"
                                Style="{StaticResource AccentButtonStyle}"
                                Margin="8,0,0,0"
                                Click="StartScan_Click" />
                        <TextBox x:Name="TargetFolderBox"
                                 Style="{StaticResource ModernTextBoxStyle}" />
                    </DockPanel>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Keep Oldest per Group"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,6,0"
                                    Click="KeepOldest_Click" />
                            <Button Content="Keep Newest per Group"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Margin="0,0,6,0"
                                    Click="KeepNewest_Click" />
                            <Button Content="Uncheck All"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="9,4"
                                    FontSize="11.5"
                                    Click="UncheckAll_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <CheckBox x:Name="RecursiveCheck" Content="Include subfolders" IsChecked="True" Margin="0,0,16,0" />
                            <CheckBox x:Name="IncludeHiddenCheck" Content="Include hidden files" Margin="0,0,16,0" />
                            <CheckBox x:Name="IncludeEmptyCheck" Content="Include 0-byte empty files" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Grouped Duplicate List -->
            <Border Grid.Row="2"
                    Background="{DynamicResource BrowserBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                <ListView x:Name="DuplicatesListView"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          ItemContainerStyle="{StaticResource ModernFileListItemStyle}"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                                            Padding="10,5"
                                            Margin="0,4,0,2"
                                            CornerRadius="4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListView.GroupStyle>

                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Recycle" Width="62">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsMarkedForRemoval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center"
                                                  Checked="EntryCheck_Changed"
                                                  Unchecked="EntryCheck_Changed" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File Name" Width="210" DisplayMemberBinding="{Binding FileName}" />
                            <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding FormattedSize}" />
                            <GridViewColumn Header="Modified" Width="145" DisplayMemberBinding="{Binding ModifiedTime, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                            <GridViewColumn Header="Directory" Width="355" DisplayMemberBinding="{Binding DirectoryPath}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

            <!-- Footer -->
            <DockPanel Grid.Row="3" Margin="0,14,0,0">
                <TextBlock x:Name="StatusFooterText"
                           DockPanel.Dock="Left"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Text="Click 'Scan Folder' to detect exact byte-identical duplicates." />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="RecycleSelectedButton"
                            Content="Move Checked to Recycle Bin"
                            Style="{StaticResource DangerButtonStyle}"
                            IsEnabled="False"
                            Margin="0,0,8,0"
                            Click="RecycleSelected_Click" />
                    <Button Content="Close"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="88" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
