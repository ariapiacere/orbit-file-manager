<Window x:Class="OrbitFileManager.Views.Dialogs.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Border Padding="22" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="HeaderTitleText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="0,0,0,10" />

            <TextBlock x:Name="MessageBodyText"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       LineHeight="19" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn"
                        Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="84"
                        Margin="0,0,8,0" />
                <Button x:Name="ConfirmBtn"
                        Content="Confirm"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="100"
                        Click="ConfirmBtn_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
