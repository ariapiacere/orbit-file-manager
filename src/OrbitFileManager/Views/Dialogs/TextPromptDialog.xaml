<Window x:Class="OrbitFileManager.Views.Dialogs.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Border Padding="20" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="PromptLabel"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10" />

            <TextBox x:Name="InputBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     FontSize="13.5"
                     Padding="10,7"
                     TextChanged="InputBox_TextChanged" />

            <TextBlock x:Name="ValidationErrorText"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="11.5"
                       Margin="2,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        MinWidth="84"
                        Margin="0,0,8,0" />
                <Button x:Name="OkButton"
                        Content="Confirm"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        MinWidth="92"
                        Click="OkButton_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
