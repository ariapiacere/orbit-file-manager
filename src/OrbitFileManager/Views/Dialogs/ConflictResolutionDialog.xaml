<Window x:Class="OrbitFileManager.Views.Dialogs.ConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Conflict Detected"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI">

    <Border Padding="22" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Destination already contains an item with this name"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />

            <TextBlock x:Name="ItemNameText"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,12" />

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="SOURCE ITEM" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="SourceDetailsText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <StackPanel>
                        <TextBlock Text="EXISTING DESTINATION" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" />
                        <TextBlock x:Name="DestDetailsText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <CheckBox x:Name="ApplyToAllCheck"
                      Content="Apply this choice to all remaining conflicts in this operation"
                      Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel"
                        IsCancel="True"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Cancel_Click" />
                <Button Content="Skip"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Skip_Click" />
                <Button Content="Overwrite"
                        Style="{StaticResource DangerButtonStyle}"
                        Margin="0,0,8,0"
                        Click="Overwrite_Click" />
                <Button Content="Keep Both (Rename)"
                        IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="KeepBoth_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
