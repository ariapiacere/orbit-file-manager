<Window x:Class="OrbitFileManager.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update Orbit"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Closing="Window_Closing">

    <Border Padding="22" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock x:Name="HeaderText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4" />
            <TextBlock x:Name="SubheaderText"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,0,0,12" />

            <TextBlock Text="WHAT'S NEW" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="NotesBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="12"
                     Height="170" />

            <TextBlock x:Name="ReadOnlyInstallText"
                       Text="Orbit is running from a folder it cannot write to, so it can't update itself. Download the new version from the release page and replace this copy."
                       FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed" />

            <StackPanel x:Name="ProgressPanel" Margin="0,14,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="DownloadProgress"
                             Height="5"
                             Minimum="0"
                             Maximum="1"
                             Background="{DynamicResource InputBackgroundBrush}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0" />
                <TextBlock x:Name="ProgressText"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>

            <DockPanel Margin="0,20,0,0">
                <Button DockPanel.Dock="Left"
                        Content="Release page"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="ReleasePage_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterButton"
                            Content="Later"
                            IsCancel="True"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="84"
                            Margin="0,0,8,0" />
                    <Button x:Name="InstallButton"
                            Content="Install and restart"
                            IsDefault="True"
                            Style="{StaticResource AccentButtonStyle}"
                            MinWidth="140"
                            Click="Install_Click" />
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
