<UserControl x:Class="OrbitFileManager.Controls.BrowserPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:OrbitFileManager.Models"
             xmlns:converters="clr-namespace:OrbitFileManager.Converters"
             xmlns:local="clr-namespace:OrbitFileManager.Controls"
             x:Name="PaneRoot"
             AllowDrop="True"
             PreviewMouseDown="PaneRoot_PreviewMouseDown"
             DragOver="PaneRoot_DragOver"
             Drop="PaneRoot_Drop">

    <UserControl.Resources>
        <converters:BooleanToVisibilityExConverter x:Key="BoolToVis" />
        <converters:NullOrEmptyToVisibilityConverter x:Key="NullToVis" />
        <converters:EnumEqualsToVisibilityConverter x:Key="EnumToVis" />
        <converters:CutOpacityConverter x:Key="CutOpacity" />
        <converters:HexStringToBrushConverter x:Key="HexToBrush" />

        <!-- Group Header Style when Group by File Type is active -->
        <GroupStyle x:Key="FileCategoryGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource ToolbarBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="10,4"
                            Margin="0,6,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
        </GroupStyle>

        <!-- File List Context Menu (PlacementTarget.Tag = MainViewModel) -->
        <ContextMenu x:Key="PaneFileContextMenu"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Open" InputGestureText="Enter" Command="{Binding OpenSelectedCommand}" />
            <MenuItem Header="Open Folder in New Tab" InputGestureText="Middle-Click" Command="{Binding OpenSelectedInNewTabCommand}" />
            <MenuItem Header="Open Containing Folder" Command="{Binding OpenContainingFolderCommand}" />
            <MenuItem Header="Reveal in Windows Explorer" Command="{Binding RevealSelectedInExplorerCommand}" />
            <Separator />
            <MenuItem Header="Cut" InputGestureText="Ctrl+X" Command="{Binding CutSelectedCommand}" />
            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Command="{Binding CopySelectedCommand}" />
            <MenuItem Header="Paste" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
            <MenuItem Header="Copy to Other Pane" Command="{Binding CopyToOtherPaneCommand}" Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Move to Other Pane" Command="{Binding MoveToOtherPaneCommand}" Visibility="{Binding IsDualPane, Converter={StaticResource BoolToVis}}" />
            <Separator />
            <MenuItem Header="Rename" InputGestureText="F2" Command="{Binding RenameSelectedCommand}" />
            <MenuItem Header="Batch Rename Selected..." InputGestureText="Ctrl+M" Command="{Binding OpenBatchRenameCommand}" />
            <MenuItem Header="Undo Last Batch Rename" InputGestureText="Ctrl+Z" Command="{Binding UndoLastBatchRenameCommand}" />
            <MenuItem Header="Delete (Recycle Bin)" InputGestureText="Del" Command="{Binding DeleteToRecycleBinCommand}" />
            <MenuItem Header="Delete Permanently..." InputGestureText="Shift+Del" Command="{Binding DeletePermanentlyCommand}" />
            <Separator />
            <MenuItem Header="Color Tag">
                <MenuItem Header="Red" Command="{Binding SetColorTagCommand}" CommandParameter="#FFEF4444" />
                <MenuItem Header="Amber" Command="{Binding SetColorTagCommand}" CommandParameter="#FFF59E0B" />
                <MenuItem Header="Emerald" Command="{Binding SetColorTagCommand}" CommandParameter="#FF10B981" />
                <MenuItem Header="Blue" Command="{Binding SetColorTagCommand}" CommandParameter="#FF3B82F6" />
                <MenuItem Header="Purple" Command="{Binding SetColorTagCommand}" CommandParameter="#FF8B5CF6" />
                <Separator />
                <MenuItem Header="Clear Tag" Command="{Binding SetColorTagCommand}" CommandParameter="" />
            </MenuItem>
            <MenuItem Header="New Folder..." InputGestureText="Ctrl+Shift+N" Command="{Binding CreateNewFolderCommand}" />
            <MenuItem Header="New Text File..." InputGestureText="Ctrl+N" Command="{Binding CreateNewFileCommand}" />
            <MenuItem Header="Add to Favorites" Command="{Binding AddSelectedToFavoritesCommand}" />
            <Separator />
            <MenuItem Header="Copy Full Path" InputGestureText="Ctrl+Shift+C" Command="{Binding CopyFullPathCommand}" />
            <MenuItem Header="Copy Selected Filename List" Command="{Binding CopyFileNameCommand}" />
            <MenuItem Header="Copy Relative Path" Command="{Binding CopyRelativePathCommand}" />
            <Separator />
            <MenuItem Header="Calculate File Checksums..." InputGestureText="Ctrl+Shift+K" Command="{Binding OpenChecksumToolCommand}" />
            <MenuItem Header="Analyze Folder Size..." InputGestureText="Ctrl+Shift+Z" Command="{Binding OpenFolderSizeAnalyzerCommand}" />
            <MenuItem Header="Find Duplicate Files..." InputGestureText="Ctrl+Shift+U" Command="{Binding OpenDuplicateFinderCommand}" />
            <Separator />
            <MenuItem Header="Group by File Type" IsCheckable="True" IsChecked="{Binding ActiveTab.GroupByType, Mode=TwoWay}" />
            <MenuItem Header="Properties" InputGestureText="Alt+Enter" Command="{Binding ShowPropertiesCommand}" />
        </ContextMenu>

        <!-- Details Column Header Visibility Menu -->
        <ContextMenu x:Key="ColumnHeaderContextMenu"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Extension Column" IsCheckable="True" IsChecked="{Binding ShowExtensionColumn, Mode=TwoWay}" />
            <MenuItem Header="Size Column" IsCheckable="True" IsChecked="{Binding ShowSizeColumn, Mode=TwoWay}" />
            <MenuItem Header="Type Column" IsCheckable="True" IsChecked="{Binding ShowTypeColumn, Mode=TwoWay}" />
            <MenuItem Header="Date Modified Column" IsCheckable="True" IsChecked="{Binding ShowModifiedColumn, Mode=TwoWay}" />
            <MenuItem Header="Date Created Column" IsCheckable="True" IsChecked="{Binding ShowCreatedColumn, Mode=TwoWay}" />
            <MenuItem Header="Attributes Column" IsCheckable="True" IsChecked="{Binding ShowAttributesColumn, Mode=TwoWay}" />
            <Separator />
            <MenuItem Header="Group by File Type" IsCheckable="True" IsChecked="{Binding ActiveTab.GroupByType, Mode=TwoWay}" />
        </ContextMenu>
    </UserControl.Resources>

    <!-- The active pane is marked by the orange glow on its selected tab (see the tab template below) -->
    <Border Background="{DynamicResource BrowserBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Row 0: Pane Tab Strip -->
                <RowDefinition Height="Auto" />
                <!-- Row 1: Breadcrumb / Address & Quick Filter -->
                <RowDefinition Height="Auto" />
                <!-- Row 2: Error Banner -->
                <RowDefinition Height="Auto" />
                <!-- Row 3: File Views -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ─── ROW 0: TAB STRIP ────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="6,4,6,0">
                <!-- Tabs, then the + button right after the last tab (pinned to the edge once the tabs overflow) -->
                <local:TabStripPanel>
                    <ListBox x:Name="PaneTabListBox"
                             ItemsSource="{Binding Tabs}"
                             SelectedItem="{Binding ActiveTab, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="{x:Type ListBoxItem}">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,3,0" />
                                <Setter Property="AllowDrop" Value="True" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                            <Grid>
                                                <Border x:Name="TabPill"
                                                        Background="{DynamicResource InactiveTabBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1,1,1,0"
                                                        CornerRadius="6,6,0,0"
                                                        Padding="8,5,5,5"
                                                        MinWidth="90"
                                                        MaxWidth="215"
                                                        Cursor="Hand"
                                                        ToolTip="{Binding CurrentPath}"
                                                        AllowDrop="True"
                                                        MouseDown="TabPill_MouseDown"
                                                        MouseMove="TabPill_MouseMove"
                                                        Drop="TabPill_Drop">
                                                    <Border.ContextMenu>
                                                        <ContextMenu Loaded="TabContextMenu_Loaded">
                                                            <MenuItem Header="New Tab" InputGestureText="Ctrl+T" Click="TabMenu_NewTab_Click" />
                                                            <MenuItem Header="Duplicate Tab" Click="TabMenu_Duplicate_Click" />
                                                            <MenuItem Header="Reopen Closed Tab" InputGestureText="Ctrl+Shift+T" Click="TabMenu_RestoreClosed_Click" />
                                                            <Separator />
                                                            <MenuItem x:Name="PinMenuItem" Header="Pin / Unpin Tab" Click="TabMenu_Pin_Click" />
                                                            <MenuItem x:Name="LockMenuItem" Header="Lock / Unlock Tab" Click="TabMenu_Lock_Click" />
                                                            <MenuItem Header="Rename Tab Label..." Click="TabMenu_Rename_Click" />
                                                            <MenuItem Header="Reset Custom Label" Click="TabMenu_ResetLabel_Click" />
                                                            <Separator />
                                                            <MenuItem Header="Close Other Tabs" Click="TabMenu_CloseOthers_Click" />
                                                            <MenuItem Header="Close Tab" InputGestureText="Ctrl+W" Click="TabMenu_Close_Click" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Pin / Lock Indicators -->
                                                        <Path Grid.Column="0"
                                                              Data="{StaticResource IconPin}"
                                                              Stroke="{DynamicResource AccentBrush}"
                                                              StrokeThickness="1.7"
                                                              Width="11" Height="11"
                                                              Stretch="Uniform"
                                                              Margin="0,0,5,0"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />

                                                        <Path Grid.Column="1"
                                                              Data="{StaticResource IconLock}"
                                                              Stroke="#FFF59E0B"
                                                              StrokeThickness="1.7"
                                                              Width="11" Height="11"
                                                              Stretch="Uniform"
                                                              Margin="0,0,5,0"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding IsLocked, Converter={StaticResource BoolToVis}}" />

                                                        <TextBlock x:Name="TabTitleText"
                                                                   Grid.Column="2"
                                                                   Text="{Binding DisplayTitle}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />

                                                        <Button Grid.Column="3"
                                                                Style="{StaticResource ToolbarButtonStyle}"
                                                                Padding="4,2"
                                                                Margin="5,0,0,0"
                                                                ToolTip="Close Tab (Ctrl+W or Middle-Click)"
                                                                Visibility="{Binding CanCloseTab, Converter={StaticResource BoolToVis}}"
                                                                Click="CloseTabButton_Click">
                                                            <Path Data="{StaticResource IconClose}"
                                                                  Stroke="{DynamicResource TextMutedBrush}"
                                                                  StrokeThickness="1.8"
                                                                  StrokeStartLineCap="Round"
                                                                  Width="8.5" Height="8.5"
                                                                  Stretch="Uniform" />
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                                    <Setter TargetName="TabTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ToolbarBackgroundBrush}" />
                                                    <Setter TargetName="TabPill" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    <Setter TargetName="TabTitleText" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter TargetName="TabTitleText" Property="FontWeight" Value="SemiBold" />
                                                </Trigger>
                                                <!-- Selected tab of the active pane glows orange; in dual-pane mode the other
                                                     pane's selected tab stays plain, so the glow also shows which pane is active -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsActivePane, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ActiveTabGlowBrush}" />
                                                    <Setter TargetName="TabPill" Property="BorderBrush" Value="{DynamicResource ActiveTabGlowBorderBrush}" />
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <Button x:Name="NewTabButton"
                            Style="{StaticResource ToolbarButtonStyle}"
                            Command="{Binding NewTabCommand}"
                            Padding="6,4"
                            Margin="2,0,0,3"
                            VerticalAlignment="Center"
                            ToolTip="New Tab in this Pane (Ctrl+T)">
                        <Path Data="{StaticResource IconPlus}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.9" StrokeStartLineCap="Round" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </local:TabStripPanel>
            </Border>

            <!-- ─── ROW 1: BREADCRUMB / ADDRESS BAR + QUICK FILTER ──────────── -->
            <Border Grid.Row="1"
                    Background="{DynamicResource ToolbarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="195" />
                    </Grid.ColumnDefinitions>

                    <!-- Breadcrumb / Editable Address -->
                    <Grid Grid.Column="0">
                        <Border Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="5,2"
                                MinHeight="29"
                                Cursor="IBeam"
                                Visibility="{Binding ActiveTab.IsAddressEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"
                                PreviewMouseLeftButtonDown="BreadcrumbBar_MouseLeftButtonDown">
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Style="{StaticResource ToolbarButtonStyle}"
                                        Padding="4,2"
                                        ToolTip="Pin Current Folder to Favorites"
                                        Click="PinCurrentToFavorites_Click">
                                    <Path Data="{StaticResource IconStar}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" />
                                </Button>

                                <!-- Not focusable: a ScrollViewer hit-tests its whole area and would otherwise take the click (and focus) meant for the bar -->
                                <ScrollViewer x:Name="BreadcrumbScrollViewer"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Disabled"
                                              VerticalAlignment="Center"
                                              ScrollChanged="BreadcrumbScrollViewer_ScrollChanged">
                                    <ItemsControl ItemsSource="{Binding ActiveTab.Breadcrumbs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ToolbarButtonStyle}"
                                                            Padding="5,2"
                                                            Margin="0"
                                                            Tag="{Binding FullPath}"
                                                            ToolTip="{Binding FullPath}"
                                                            Click="BreadcrumbSegment_Click">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" />
                                                    </Button>
                                                    <Path Data="{StaticResource IconChevronRight}"
                                                          Stroke="{DynamicResource TextMutedBrush}"
                                                          StrokeThickness="1.6"
                                                          Width="7" Height="7"
                                                          Stretch="Uniform"
                                                          Margin="1,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsLast, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <TextBox x:Name="PaneAddressTextBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="29"
                                 Text="{Binding ActiveTab.AddressInputText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ActiveTab.IsAddressEditing, Converter={StaticResource BoolToVis}}"
                                 KeyDown="AddressTextBox_KeyDown"
                                 LostKeyboardFocus="AddressTextBox_LostKeyboardFocus" />
                    </Grid>

                    <!-- Quick Filter -->
                    <Grid Grid.Column="2">
                        <TextBox x:Name="PaneQuickFilterBox"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 MinHeight="29"
                                 Padding="26,3,24,3"
                                 Text="{Binding ActiveTab.QuickFilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Quick filter current folder (Ctrl+F)" />
                        <Path Data="{StaticResource IconSearch}"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="1.7"
                              Width="12" Height="12"
                              Stretch="Uniform"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              Margin="9,0,0,0"
                              IsHitTestVisible="False" />
                        <TextBlock Text="Filter..."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11.5"
                                   VerticalAlignment="Center"
                                   Margin="28,0,22,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding ActiveTab.QuickFilterText, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
                        <Button Style="{StaticResource ToolbarButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Padding="4,3"
                                Margin="0,0,2,0"
                                ToolTip="Clear Filter"
                                Click="ClearFilter_Click"
                                Visibility="{Binding ActiveTab.QuickFilterText, Converter={StaticResource NullToVis}}">
                            <Path Data="{StaticResource IconClose}" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.8" Width="8" Height="8" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ─── ROW 2: ERROR BANNER ─────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DangerSubtleBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="10,6"
                    Visibility="{Binding ActiveTab.ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ActiveTab.ErrorMessage}"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ─── ROW 3: FILE BROWSER VIEWS (5 MODES) ─────────────────────── -->
            <Grid Grid.Row="3">

                <!-- 1. DETAILS VIEW -->
                <ListView x:Name="DetailsListView"
                          ItemsSource="{Binding ActiveTab.DisplayedItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource ModernFileListItemStyle}"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                          ContextMenu="{StaticResource PaneFileContextMenu}"
                          Visibility="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Details}"
                          RequestBringIntoView="DetailsListView_RequestBringIntoView"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseDown="FileListView_PreviewMouseDown"
                          PreviewMouseMove="FileListView_PreviewMouseMove">
                    <ListView.GroupStyle>
                        <StaticResource ResourceKey="FileCategoryGroupStyle" />
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView x:Name="DetailsGridView" AllowsColumnReorder="True">
                            <!-- Name (width is fitted to the free space in code-behind until the user resizes it) -->
                            <GridViewColumn x:Name="ColName" Width="260">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Name"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Name_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- DockPanel (not StackPanel) so the name gets a bounded width and can show an ellipsis.
                                             Named: a drag that starts here moves files, one on another column draws a selection rectangle. -->
                                        <DockPanel x:Name="NameCell" Opacity="{Binding IsCutPending, Converter={StaticResource CutOpacity}}">
                                            <Ellipse DockPanel.Dock="Left"
                                                     Width="7" Height="7"
                                                     Fill="{Binding ColorTagHex, Converter={StaticResource HexToBrush}}"
                                                     Margin="2,0,5,0"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding ColorTagHex, Converter={StaticResource NullToVis}}" />
                                            <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="1,0,7,0" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right"
                                                    Background="{DynamicResource AccentSubtleBrush}"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="3"
                                                    Padding="4,0"
                                                    Margin="6,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding ComparisonBadge, Converter={StaticResource NullToVis}}">
                                                <TextBlock Text="{Binding ComparisonBadge}" FontSize="9.5" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Name}"
                                                       ToolTipService.InitialShowDelay="900"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Extension -->
                            <GridViewColumn x:Name="ColExtension" Width="56">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Ext"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Ext_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayExtension}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Size -->
                            <GridViewColumn x:Name="ColSize" Width="80">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Size"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Size_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Typography.NumeralAlignment="Tabular" HorizontalAlignment="Right" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Type -->
                            <GridViewColumn x:Name="ColType" Width="132">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Type"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Type_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TypeDescription}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Modified -->
                            <GridViewColumn x:Name="ColModified" Width="124">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Date Modified"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Modified_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ModifiedText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Created -->
                            <GridViewColumn x:Name="ColCreated" Width="124">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Date Created"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}"
                                                          Click="SortHeader_Created_Click" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CreatedText}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Typography.NumeralAlignment="Tabular" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Attributes -->
                            <GridViewColumn x:Name="ColAttr" Width="48">
                                <GridViewColumn.Header>
                                    <GridViewColumnHeader Content="Attr"
                                                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                                                          ContextMenu="{StaticResource ColumnHeaderContextMenu}" />
                                </GridViewColumn.Header>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding AttributesSummary}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" FontFamily="Consolas" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>

                <!-- 2. LIST VIEW (Multi-Column Vertical Wrap) -->
                <ListView x:Name="CompactListView"
                          ItemsSource="{Binding ActiveTab.DisplayedItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource ModernTileListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled"
                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                          ContextMenu="{StaticResource PaneFileContextMenu}"
                          Visibility="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=List}"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseDown="FileListView_PreviewMouseDown"
                          PreviewMouseMove="FileListView_PreviewMouseMove">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Vertical" ItemWidth="220" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Opacity="{Binding IsCutPending, Converter={StaticResource CutOpacity}}">
                                <Ellipse Width="6" Height="6" Fill="{Binding ColorTagHex, Converter={StaticResource HexToBrush}}" Margin="0,0,4,0" Visibility="{Binding ColorTagHex, Converter={StaticResource NullToVis}}" />
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Width="180" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 3. SMALL ICONS VIEW -->
                <ListView x:Name="SmallIconsListView"
                          ItemsSource="{Binding ActiveTab.DisplayedItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource ModernTileListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                          ContextMenu="{StaticResource PaneFileContextMenu}"
                          Visibility="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=SmallIcons}"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseDown="FileListView_PreviewMouseDown"
                          PreviewMouseMove="FileListView_PreviewMouseMove">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="185" ItemHeight="32" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Opacity="{Binding IsCutPending, Converter={StaticResource CutOpacity}}">
                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" Width="148" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 4. LARGE ICONS VIEW -->
                <ListView x:Name="LargeIconsListView"
                          ItemsSource="{Binding ActiveTab.DisplayedItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource ModernTileListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                          ContextMenu="{StaticResource PaneFileContextMenu}"
                          Visibility="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=LargeIcons}"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseDown="FileListView_PreviewMouseDown"
                          PreviewMouseMove="FileListView_PreviewMouseMove">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="122" ItemHeight="112" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="108" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="{Binding IsCutPending, Converter={StaticResource CutOpacity}}">
                                <Image Source="{Binding Icon}" Width="36" Height="36" Margin="0,3,0,5" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding FormattedSize}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 5. THUMBNAILS VIEW -->
                <ListView x:Name="ThumbnailsListView"
                          ItemsSource="{Binding ActiveTab.DisplayedItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource ModernTileListItemStyle}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          Tag="{Binding MainVm, ElementName=PaneRoot}"
                          ContextMenu="{StaticResource PaneFileContextMenu}"
                          Visibility="{Binding ActiveTab.ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Thumbnails}"
                          SelectionChanged="FileListView_SelectionChanged"
                          MouseDoubleClick="FileListView_MouseDoubleClick"
                          PreviewMouseDown="FileListView_PreviewMouseDown"
                          PreviewMouseMove="FileListView_PreviewMouseMove">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemWidth="148" ItemHeight="144" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="134" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="{Binding IsCutPending, Converter={StaticResource CutOpacity}}">
                                <Border Width="116" Height="86"
                                        CornerRadius="5"
                                        Background="{DynamicResource InputBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        Margin="0,2,0,5"
                                        ClipToBounds="True">
                                    <Image Source="{Binding BestVisual}" Stretch="Uniform" StretchDirection="DownOnly" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxHeight="32" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Empty State -->
                <TextBlock Text="No matching items in this view"
                           FontSize="13.5"
                           Foreground="{DynamicResource TextMutedBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding ActiveTab.DisplayedItemCount, Converter={StaticResource NullToVis}, ConverterParameter=Invert}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
